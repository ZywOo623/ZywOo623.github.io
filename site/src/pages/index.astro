---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GraphLab from '../components/GraphLab.jsx';
import BitLab from '../components/BitLab.jsx';
import codeforces from '../data/codeforces.json';

const posts = await getCollection('blog');
const latest = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const guide = [...posts].filter(post => post.data.category === '算法竞赛进阶指南').sort((a, b) => a.id.localeCompare(b.id));
const slug = (post) => post.id.split('/').at(-1);
const snapshotDate = codeforces.status === 'ok' ? codeforces.fetchedAt.slice(0, 10) : null;
---
<Base title="ZywOo623 · 算法控制台" description="ZywOo623 的个人主页：算法竞赛记录、交互实验和公开技术博客。" active="home">
  <section id="home" class="unveil-scene" aria-label="首页滚动揭幕">
    <div class="unveil-sticky">
      <div class="hero" aria-labelledby="hero-heading">
    <canvas class="hero-constellation" aria-hidden="true"></canvas>
    <div class="hero-field" aria-hidden="true"><span>00101101</span><span>10110010</span><span>01010110</span><span>11001001</span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="live-dot"></span> PERSONAL SYSTEM / ONLINE</div>
        <p class="hero-overline" aria-label="C++ / ALGORITHMS / COMPETITIVE PROGRAMMING"><span aria-hidden="true" data-scramble="C++ / ALGORITHMS / COMPETITIVE PROGRAMMING">C++ / ALGORITHMS / COMPETITIVE PROGRAMMING</span></p>
        <h1 id="hero-heading">ZywOo623<span class="title-stop">.</span><br /><em>Code in motion.</em></h1>
        <p class="hero-lead">从一道题、一次推导开始。这里记录算法竞赛的练习、代码实验与愿意公开分享的学习笔记。</p>
        <div class="hero-actions">
          <a class="action action-primary action-large" href="#arena">探索算法世界 <span aria-hidden="true">↘</span></a>
          <a class="action action-large" href="/blog/">阅读博客 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-index"><span>01 / 08</span><span class="hero-index-line"></span><span>SCROLL TO DECODE</span></div>
      </div>
      <div class="hero-machine" aria-hidden="true">
        <div class="machine-orbit machine-orbit-outer"></div><div class="machine-orbit machine-orbit-inner"></div>
        <div class="machine-node machine-node-a"></div><div class="machine-node machine-node-b"></div>
        <div class="machine-card">
          <div class="machine-card-head"><span class="window-dots"><i></i><i></i><i></i></span><span>algorithm.cpp</span><span>LIVE</span></div>
          <div class="machine-code"><div><small>01</small><span><b>while</b> (learning) &#123;</span></div><div><small>02</small><span>&nbsp; solve(problem);</span></div><div><small>03</small><span>&nbsp; reflect(mistakes);</span></div><div><small>04</small><span>&nbsp; share(insights);</span></div><div><small>05</small><span>&#125;</span></div></div>
          <div class="machine-card-foot"><span>STATUS: COMPILE SUCCESS</span><span>●●●●●●●○</span></div>
        </div>
        <span class="machine-float machine-float-a">0x01 / BITWISE</span>
        <span class="machine-float machine-float-b">O(log n)</span>
      </div>
    </div>
        <div class="hero-bottom"><span>BUILD / LEARN / WRITE</span><span>↙ KEEP SCROLLING</span></div>
      </div>
      <div class="unveil-curtains" aria-hidden="true">
        <div class="unveil-curtain unveil-curtain-left"><div class="curtain-content"><span>01 / SYSTEM INITIALIZING</span><strong>ZYWOO</strong><small>10110100 01010110 11001001 00101101</small></div></div>
        <div class="unveil-curtain unveil-curtain-right"><div class="curtain-content"><span>COMPETITIVE PROGRAMMING / C++</span><strong>623<span>_</span></strong><small>00110110 11001001 01010101 10101001</small></div></div>
        <div class="unveil-seam"><span>SCROLL TO REVEAL</span></div>
      </div>
      <div class="unveil-counter" aria-hidden="true">UNVEIL <span>00</span>%</div>
      <a class="unveil-skip" href="#arena">跳过揭幕 ↘</a>
    </div>
  </section>

  <div class="signal-strip" aria-hidden="true"><div class="signal-track"><span>CODE / THINK / SOLVE ✦ 0x01 BITWISE OPERATIONS ✦ GRAPH THEORY ✦ C++ ✦ LEARNING IN PUBLIC ✦&nbsp;</span><span>CODE / THINK / SOLVE ✦ 0x01 BITWISE OPERATIONS ✦ GRAPH THEORY ✦ C++ ✦ LEARNING IN PUBLIC ✦&nbsp;</span></div></div>

  <section id="arena" class="section arena-section" aria-labelledby="arena-title">
    <div class="container">
      <div class="section-kicker"><span>01 / SIGNALS</span><span>VERIFIED DATA, NO PLACEHOLDERS</span></div>
      <div class="section-heading"><div><span class="kicker">CODEFORCES / PRACTICE LOG</span><h2 id="arena-title">The work behind<br /><em>the numbers.</em></h2></div><p>竞赛数据来自公开的 Codeforces 账号。这里展示真实的练习记录；同步失败时会标明数据状态。</p></div>
      {codeforces.status === 'ok' ? (
        <>
          <div class="stat-grid">
            <div class="stat-card stat-primary"><span>PROBLEMS SOLVED</span><strong>{codeforces.solved}<small> AC</small></strong><p>{codeforces.submissionsTruncated ? '最近 10000 次提交中的不同题目' : '不同题目的通过记录'}</p><i>↗</i></div>
            <div class="stat-card"><span>SUBMISSIONS</span><strong>{codeforces.submissions}</strong><p>公开提交记录</p></div>
            <div class="stat-card"><span>RATING</span><strong>{codeforces.rating ?? '—'}</strong><p>{codeforces.rating === null ? '暂无评级记录' : codeforces.rank ?? 'Codeforces rating'}</p></div>
            <div class="stat-card"><span>RATED CONTESTS</span><strong>{codeforces.contests}</strong><p>公开评级历史</p></div>
          </div>
          <div class="activity-panel">
            <div class="activity-head"><div><span class="kicker">RECENT ACCEPTED</span><h3>最近通过的题目</h3></div><a class="text-link" href="https://codeforces.com/profile/ZywOo623" target="_blank" rel="noopener noreferrer">查看 Codeforces ↗</a></div>
            <div class="activity-list">
              {codeforces.recentAccepted.map((problem, index) => (
                <a href={`https://codeforces.com/problemset/problem/${problem.contestId}/${problem.index}`} target="_blank" rel="noopener noreferrer">
                  <span class="activity-index">{String(index + 1).padStart(2, '0')}</span><strong>{problem.name}</strong><span>{problem.rating ?? '—'}</span><time datetime={problem.date}>{problem.date}</time><b aria-hidden="true">↗</b>
                </a>
              ))}
            </div>
          </div>
          <p class="data-note">来源：Codeforces 公开 API · 快照日期 {snapshotDate} · <a href="https://codeforces.com/profile/ZywOo623" target="_blank" rel="noopener noreferrer">打开原始个人页 ↗</a></p>
        </>
      ) : (
        <div class="data-unavailable"><strong>数据暂时无法同步</strong><p>你仍可以前往 Codeforces 查看公开练习记录。</p><a class="action action-primary" href="https://codeforces.com/profile/ZywOo623" target="_blank" rel="noopener noreferrer">打开 Codeforces ↗</a></div>
      )}
    </div>
  </section>

  <section id="graph" class="section graph-section" aria-labelledby="graph-title">
    <div class="container">
      <div class="section-kicker"><span>02 / INTERACTIVE</span><span>ALGORITHM PLAYGROUND</span></div>
      <div class="section-heading"><div><span class="kicker">RUN THE ALGORITHM</span><h2 id="graph-title">Don't just watch.<br /><em>Change the graph.</em></h2></div><p>选择起点与终点，关闭一条边，再逐步观察 Dijkstra 怎样更新距离。每一次操作都会重新计算最短路。</p></div>
      <GraphLab client:visible />
    </div>
  </section>

  <section id="manifesto" class="manifesto-section" aria-label="创作与学习">
    <div class="manifesto-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="container manifesto-inner">
      <div class="manifesto-top"><span>03 / THE PROCESS</span><span>IDEAS → CODE → WORDS</span></div>
      <div class="manifesto-lines" aria-label="Think. Build. Share.">
        <span class="manifesto-line" aria-hidden="true">THINK<span>.</span></span>
        <span class="manifesto-line" aria-hidden="true">BUILD<span>.</span></span>
        <span class="manifesto-line" aria-hidden="true">SHARE<span>.</span></span>
      </div>
      <div class="manifesto-bottom"><p>从推导一道题，到写出代码，再把值得分享的思路整理成文章。这个网站会随着学习一起生长。</p><a class="action action-primary" href="/blog/">进入博客 <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section id="lab" class="section bit-section" aria-labelledby="bit-title">
    <div class="container">
      <div class="section-kicker"><span>04 / BIT LAB</span><span>01 00 11 01</span></div>
      <div class="section-heading"><div><span class="kicker">TOUCH THE BITS</span><h2 id="bit-title">Think in <em>bits.</em></h2></div><p>点亮或关闭一个二进制位，看看数值、popcount 与 lowbit 如何一起改变。</p></div>
      <BitLab client:visible />
    </div>
  </section>

  <section id="learning" class="section learning-section" aria-labelledby="learning-title">
    <div id="roadmap"></div>
    <div class="container">
      <div class="section-kicker"><span>05 / LEARNING</span><span>FROM STUDY TO PUBLIC NOTES</span></div>
      <div class="section-heading"><div><span class="kicker">ALGORITHM GUIDE</span><h2 id="learning-title">A growing<br /><em>knowledge map.</em></h2></div><p>Learning 记录我在学什么；Blog 收录已经整理、愿意公开分享的内容。状态只表示文章是否发布。</p></div>
      <div class="learning-list">
        {guide.map((post, index) => <a href={`/blog/${slug(post)}/`} class="learning-row"><span class="learning-index">{String(index + 1).padStart(2, '0')}</span><strong>{post.id.split('/').at(-1)?.startsWith('0x01') ? '0x01 位运算' : '0x02 递推与递归'}</strong><span class="learning-status"><i></i> 已发布</span><span class="learning-arrow">查看笔记 ↗</span></a>)}
        <div class="learning-row is-upcoming"><span class="learning-index">03</span><strong>下一篇学习笔记</strong><span class="learning-status">等待整理</span><span class="learning-arrow">COMING NEXT</span></div>
      </div>
      <div class="learning-bridge"><span>PRIVATE NOTES</span><b>→</b><span>PUBLIC ARTICLE</span><p>完整学习过程留在私人笔记；这里展示整理后的公开成果。</p></div>
    </div>
  </section>

  <section id="blog-preview" class="section latest-section" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-kicker"><span>06 / WRITING</span><span>WORDS, CODE AND IDEAS</span></div>
      <div class="section-heading"><div><span class="kicker">FROM THE NOTEBOOK</span><h2 id="latest-title">Ideas worth<br /><em>writing down.</em></h2></div><p>算法学习笔记、做题时的易错点，以及从思路走到代码的过程。</p></div>
      <div class="latest-grid">
        {latest.map((post, index) => <a class="latest-card" href={`/blog/${slug(post)}/`}><span class="latest-card-top"><span>{String(index + 1).padStart(2, '0')} / JOURNAL</span><span>↗</span></span><span class="latest-card-category">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="latest-card-bottom">{post.data.date.toISOString().slice(0, 10)} <b>阅读全文 →</b></span></a>)}
      </div>
      <a class="section-more" href="/blog/">浏览全部文章 <span>↗</span></a>
    </div>
  </section>

  <section id="projects" class="section projects-section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-kicker"><span>07 / PROJECTS</span><span>LEARNING BY BUILDING</span></div>
      <div class="section-heading"><div><span class="kicker">SELECTED WORK</span><h2 id="projects-title">Built to<br /><em>learn better.</em></h2></div><p>从练习记录工具到互动算法实验，项目跟着学习一起生长。</p></div>
      <div class="project-grid">
        <a href="https://zywoo623.github.io/algorithm-tracker/" target="_blank" rel="noopener noreferrer" class="project-tile"><span>01 / CODEFORCES</span><h3>Algorithm Tracker</h3><p>Codeforces 刷题记录与分析工具。</p><b>打开项目 ↗</b></a>
        <a href="#graph" class="project-tile"><span>02 / INTERACTIVE</span><h3>Graph Lab</h3><p>动手改变图，观察最短路算法运行。</p><b>开始探索 ↗</b></a>
      </div>
    </div>
  </section>

  <section id="about" class="section about-section" aria-labelledby="about-title">
    <div class="container about-grid">
      <div><div class="section-kicker"><span>08 / ABOUT</span></div><span class="kicker">HELLO, I'M ZYWOO623</span><h2 id="about-title">One problem<br /><em>at a time.</em></h2></div>
      <div class="about-copy"><p>我正在学习 C++、数据结构和算法竞赛。这个网站是练习与思考的公开记录，也是尝试把代码做得更有趣的地方。</p><p>博客文章会从私人笔记中整理发布，保留值得分享的推导、代码和易错点。</p><div><a class="action action-primary" href="https://github.com/ZywOo623" target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a class="action" href="/blog/">READ THE BLOG ↗</a></div></div>
    </div>
  </section>

  <script>
    const scene = document.querySelector<HTMLElement>('.unveil-scene');
    if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const number = scene.querySelector<HTMLElement>('.unveil-counter span');
      const skip = scene.querySelector<HTMLElement>('.unveil-skip');
      const scramble = scene.querySelector<HTMLElement>('[data-scramble]');
      let scrambled = false;
      function revealCode() {
        if (!scramble || scrambled) return;
        scrambled = true;
        const target = scramble.dataset.scramble ?? scramble.textContent ?? '';
        const glyphs = '01<>/{}';
        let frame = 0;
        function drawLetters() {
          if (!scramble) return;
          frame++;
          const stable = Math.floor(target.length * frame / 19);
          scramble.textContent = [...target].map((letter, index) => index < stable || letter === ' ' ? letter : glyphs[(index * 3 + frame) % glyphs.length]).join('');
          if (frame < 19) setTimeout(drawLetters, 35);
          else scramble.textContent = target;
        }
        drawLetters();
      }
      scene.classList.add('is-live');
      let pending = false;
      function updateScene() {
        if (!scene) return;
        // Open during the first screen of scrolling, then leave time to read the revealed hero.
        const distance = Math.max(1, Math.min(scene.offsetHeight - innerHeight, innerHeight * .8));
        const phase = Math.min(1, Math.max(0, -scene.getBoundingClientRect().top / distance));
        scene.style.setProperty('--left', `${-103 * phase}%`);
        scene.style.setProperty('--right', `${103 * phase}%`);
        scene.style.setProperty('--seam-opacity', String(Math.max(0, 1 - phase * 2)));
        scene.classList.toggle('is-open', phase > .98);
        if (phase > .82) revealCode();
        if (skip) skip.hidden = phase > .98;
        if (number) number.textContent = String(Math.round(phase * 100)).padStart(2, '0');
        pending = false;
      }
      addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(updateScene); } }, { passive: true });
      addEventListener('resize', updateScene);
      updateScene();
    }

    const manifesto = document.querySelector<HTMLElement>('.manifesto-section');
    if (manifesto && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(entries => {
        if (entries[0]?.isIntersecting) manifesto.classList.add('is-visible');
      }, { threshold: .18 });
      observer.observe(manifesto);
      let queued = false;
      function moveManifesto() {
        if (!manifesto) return;
        const rect = manifesto.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < innerHeight) {
          const progress = (innerHeight - rect.top) / (innerHeight + rect.height) - .5;
          manifesto.querySelectorAll<HTMLElement>('.manifesto-line').forEach((line, index) => {
            const direction = index === 1 ? -1 : 1;
            line.style.setProperty('--manifesto-x', `${Math.round(progress * direction * 46)}px`);
          });
        }
        queued = false;
      }
      addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(moveManifesto); } }, { passive: true });
      addEventListener('resize', moveManifesto);
      moveManifesto();
    }

    const hero = document.querySelector<HTMLElement>('.hero');
    const canvas = hero?.querySelector<HTMLCanvasElement>('.hero-constellation');
    if (hero && canvas && matchMedia('(pointer:fine) and (prefers-reduced-motion:no-preference)').matches) {
      const context = canvas.getContext('2d');
      if (context) {
        let width = 0;
        let height = 0;
        let visible = false;
        let animation = 0;
        let previous = 0;
        let pointer = { x: -1000, y: -1000 };
        let nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
        function resizeCanvas() {
          if (!hero || !canvas || !context) return;
          width = hero.clientWidth;
          height = hero.clientHeight;
          const ratio = Math.min(devicePixelRatio || 1, 1.5);
          canvas.width = Math.round(width * ratio);
          canvas.height = Math.round(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
          nodes = Array.from({ length: Math.min(48, Math.max(28, Math.round(width / 27))) }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - .5) * .48,
            vy: (Math.random() - .5) * .48,
            r: Math.random() * 1.3 + .7,
          }));
        }
        function drawNetwork(time: number) {
          if (!visible || document.hidden || !context) { animation = 0; return; }
          animation = requestAnimationFrame(drawNetwork);
          if (time - previous < 32) return;
          previous = time;
          context.clearRect(0, 0, width, height);
          nodes.forEach((node, index) => {
            node.x = (node.x + node.vx + width) % width;
            node.y = (node.y + node.vy + height) % height;
            for (let other = index + 1; other < nodes.length; other++) {
              const dx = node.x - nodes[other].x;
              const dy = node.y - nodes[other].y;
              const distance = Math.hypot(dx, dy);
              if (distance >= 140) continue;
              context.strokeStyle = `rgba(114,217,197,${(1 - distance / 140) * .19})`;
              context.lineWidth = 1;
              context.beginPath();
              context.moveTo(node.x, node.y);
              context.lineTo(nodes[other].x, nodes[other].y);
              context.stroke();
            }
            const pointerDistance = Math.hypot(node.x - pointer.x, node.y - pointer.y);
            if (pointerDistance < 170) {
              context.strokeStyle = `rgba(198,245,120,${(1 - pointerDistance / 170) * .45})`;
              context.beginPath();
              context.moveTo(node.x, node.y);
              context.lineTo(pointer.x, pointer.y);
              context.stroke();
            }
            context.fillStyle = index % 7 === 0 ? 'rgba(198,245,120,.75)' : 'rgba(114,217,197,.5)';
            context.beginPath();
            context.arc(node.x, node.y, node.r, 0, Math.PI * 2);
            context.fill();
          });
        }
        resizeCanvas();
        new IntersectionObserver(entries => {
          visible = Boolean(entries[0]?.isIntersecting);
          if (visible && !animation) animation = requestAnimationFrame(drawNetwork);
          if (!visible && animation) { cancelAnimationFrame(animation); animation = 0; }
        }, { threshold: .03 }).observe(hero);
        hero.addEventListener('pointermove', event => {
          const rect = hero.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          pointer = { x, y };
          hero.style.setProperty('--hero-shift-x', `${((x / width) - .5) * 20}px`);
          hero.style.setProperty('--hero-shift-y', `${((y / height) - .5) * 16}px`);
        }, { passive: true });
        hero.addEventListener('pointerleave', () => {
          pointer = { x: -1000, y: -1000 };
          hero.style.setProperty('--hero-shift-x', '0px');
          hero.style.setProperty('--hero-shift-y', '0px');
        });
        addEventListener('resize', resizeCanvas);
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden && visible && !animation) animation = requestAnimationFrame(drawNetwork);
        });
      }
    }
  </script>
</Base>
