---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'blog';
}

const { title, description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const commandPosts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081217" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <nav class="site-nav container" aria-label="主导航">
        <a class="brand" href="/" aria-label="ZywOo623 首页"><span class="brand-mark"><img src="/avatar-gokou.webp" alt="" width="43" height="43" decoding="async" /></span><span class="brand-name">ZYWOO623<small>ALGORITHM SYSTEM</small></span></a>
        <button class="menu-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="打开导航"><span></span><span></span><span></span></button>
        <div id="nav-links" class="nav-links">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>HOME</a>
          <a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>BLOG</a>
          <a href="/#projects">PROJECTS</a>
          <a href="/#learning">LEARNING</a>
          <a href="/#arena">CF DATA</a>
          <a href="/#about">ABOUT</a>
        </div>
        <button class="command-trigger" type="button" aria-label="打开快速跳转" aria-keyshortcuts="Control+K Meta+K"><span aria-hidden="true">⌕</span><kbd>CTRL K</kbd></button>
        <a class="nav-signal" href="https://zywoo623.github.io/algorithm-tracker/" target="_blank" rel="noopener noreferrer"><span class="live-dot"></span> ALGORITHM TRACKER ↗</a>
      </nav>
    </header>
    <dialog class="command-dialog" aria-label="快速跳转">
      <div class="command-head"><span>↳ NAVIGATE / ZYWOO623</span><button class="command-close" type="button" aria-label="关闭快速跳转">ESC ×</button></div>
      <label class="command-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="搜索页面、实验或文章…" aria-label="搜索网站内容" autocomplete="off" /><kbd>↵</kbd></label>
      <div class="command-list">
        <div class="command-group"><span>EXPLORE / 探索</span>
          <a href="/" data-command-label="首页 home 揭幕"><i>⌂</i><strong>首页</strong><small>HOME</small></a>
          <a href="/#arena" data-command-label="刷题记录 codeforces problems"><i>↗</i><strong>刷题记录</strong><small>PROBLEMS</small></a>
          <a href="/#graph" data-command-label="图算法 graph dijkstra 最短路"><i>◇</i><strong>图算法实验</strong><small>GRAPH LAB</small></a>
          <a href="/#manifesto" data-command-label="创作 学习 think build share"><i>✦</i><strong>创作与学习</strong><small>PROCESS</small></a>
          <a href="/#lab" data-command-label="位运算 bit lab 二进制"><i>01</i><strong>位运算实验</strong><small>BIT LAB</small></a>
          <a href="/#learning" data-command-label="学习记录 learning 算法竞赛进阶指南"><i>◎</i><strong>学习记录</strong><small>LEARNING</small></a>
          <a href="/#projects" data-command-label="项目 projects algorithm tracker"><i>↗</i><strong>项目展示</strong><small>PROJECTS</small></a>
          <a href="https://zywoo623.github.io/algorithm-tracker/" target="_blank" rel="noopener noreferrer" data-command-label="algorithm tracker Codeforces 完整刷题记录 错题复习"><i>CF</i><strong>Algorithm Tracker</strong><small>TOOL ↗</small></a>
        </div>
        <div class="command-group"><span>READ / 阅读</span>
          <a href="/blog/" data-command-label="博客 blog 文章列表"><i>↗</i><strong>全部文章</strong><small>BLOG</small></a>
          {commandPosts.map((post, index) => <a href={`/blog/${post.id.split('/').at(-1)}/`} data-command-label={`${post.data.title} ${post.data.category} ${post.data.tags.join(' ')}`}><i>{String(index + 1).padStart(2, '0')}</i><strong>{post.data.title}</strong><small>POST</small></a>)}
        </div>
      </div>
      <p class="command-empty" hidden>没有找到匹配内容。试试“学习”或“博客”。</p>
      <div class="command-foot"><span>↑ ↓ 浏览 · ↵ 打开 · ESC 关闭</span><span>CTRL / ⌘ + K</span></div>
    </dialog>
    {active === 'home' && <nav class="section-rail" aria-label="首页章节导航">
      <a href="#home" data-rail-target="home" aria-current="location"><span>01</span><b>HOME</b></a>
      <a href="#arena" data-rail-target="arena"><span>02</span><b>CF DATA</b></a>
      <a href="#learning" data-rail-target="learning"><span>03</span><b>LEARNING</b></a>
      <a href="#blog-preview" data-rail-target="blog-preview"><span>04</span><b>BLOG</b></a>
      <a href="#projects" data-rail-target="projects"><span>05</span><b>PROJECTS</b></a>
      <a href="#about" data-rail-target="about"><span>06</span><b>ABOUT</b></a>
    </nav>}
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><a class="footer-brand" href="/">ZYWOO623<span>_</span></a><p>Learning in public. One problem at a time.</p></div>
        <div class="footer-links"><a href="/#learning">Learning</a><a href="/blog/">Blog</a><a href="https://github.com/ZywOo623" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://codeforces.com/profile/ZywOo623" target="_blank" rel="noopener noreferrer">Codeforces ↗</a></div>
        <div class="footer-end">© {new Date().getFullYear()} ZywOo623<br /><span>BUILT WITH CURIOSITY / 编写中</span></div>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const links = document.querySelector<HTMLElement>('.nav-links');
      function closeMenu() {
        menu?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      }
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
      });
      links?.addEventListener('click', event => {
        if ((event.target as HTMLElement).closest('a')) closeMenu();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeMenu();
      });
      const fill = document.querySelector<HTMLElement>('.reading-progress span');
      const header = document.querySelector<HTMLElement>('.site-header');
      const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail-target]')];
      const railSections = railLinks.map(link => document.getElementById(link.dataset.railTarget ?? '')).filter((section): section is HTMLElement => Boolean(section));
      let scheduled = false;
      function updateProgress() {
        const length = document.documentElement.scrollHeight - window.innerHeight;
        if (fill) fill.style.width = `${length > 0 ? Math.min(100, window.scrollY / length * 100) : 0}%`;
        header?.classList.toggle('is-floating', window.scrollY > 42);
        if (railSections.length) {
          const current = [...railSections].reverse().find(section => section.getBoundingClientRect().top <= window.innerHeight * .45) ?? railSections[0];
          railLinks.forEach(link => {
            if (link.dataset.railTarget === current.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
        scheduled = false;
      }
      window.addEventListener('scroll', () => {
        if (!scheduled) { scheduled = true; requestAnimationFrame(updateProgress); }
      }, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const counters = document.querySelectorAll<HTMLElement>('[data-count]');
        const counterObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const element = entry.target as HTMLElement;
            const goal = Number(element.dataset.count);
            if (!Number.isFinite(goal) || goal < 0) return;
            counterObserver.unobserve(element);
            const start = performance.now();
            function tick(now: number) {
              const progress = Math.min(1, (now - start) / 1050);
              const eased = 1 - Math.pow(1 - progress, 3);
              element.textContent = String(Math.round(goal * eased));
              if (progress < 1) requestAnimationFrame(tick);
              else element.textContent = String(goal);
            }
            requestAnimationFrame(tick);
          });
        }, { threshold: .6 });
        counters.forEach(counter => counterObserver.observe(counter));
      }
      if (matchMedia('(pointer:fine) and (prefers-reduced-motion:no-preference)').matches) {
        document.querySelectorAll<HTMLElement>('.latest-card, .article-card > a').forEach(card => {
          card.addEventListener('pointermove', event => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
            card.style.setProperty('--my', `${event.clientY - rect.top}px`);
          }, { passive: true });
        });
        let pointerFrame = 0;
        document.addEventListener('pointermove', event => {
          if (pointerFrame) return;
          const x = event.clientX;
          const y = event.clientY;
          pointerFrame = requestAnimationFrame(() => {
            document.documentElement.style.setProperty('--cursor-x', `${x}px`);
            document.documentElement.style.setProperty('--cursor-y', `${y}px`);
            pointerFrame = 0;
          });
        }, { passive: true });
        document.querySelectorAll<HTMLElement>('.project-tile').forEach(card => {
          card.addEventListener('pointermove', event => {
            const box = card.getBoundingClientRect();
            const x = (event.clientX - box.left) / box.width - .5;
            const y = (event.clientY - box.top) / box.height - .5;
            card.style.setProperty('--mx', `${event.clientX - box.left}px`);
            card.style.setProperty('--my', `${event.clientY - box.top}px`);
            card.style.transform = `perspective(950px) rotateX(${-y * 6}deg) rotateY(${x * 6}deg) translateY(-4px)`;
          }, { passive: true });
          card.addEventListener('pointerleave', () => { card.style.transform = ''; });
        });
        document.querySelectorAll<HTMLElement>('.hero-actions .action, .manifesto-bottom .action').forEach(button => {
          button.classList.add('is-magnetic');
          button.addEventListener('pointermove', event => {
            const box = button.getBoundingClientRect();
            button.style.translate = `${(event.clientX - box.left - box.width / 2) * .14}px ${(event.clientY - box.top - box.height / 2) * .14}px`;
          }, { passive: true });
          button.addEventListener('pointerleave', () => { button.style.translate = '0 0'; });
        });
      }
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion:reduce)').matches) {
        const reveal = document.querySelectorAll<HTMLElement>('.section-heading, .stat-card, .activity-panel, .interactive-reveal, .learning-row, .latest-card, .project-tile, .blog-hero-grid, .article-card');
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: .08, rootMargin: '0px 0px -5% 0px' });
        reveal.forEach((element, index) => {
          element.classList.add('reveal-item');
          element.style.setProperty('--reveal-delay', `${index % 4 * 65}ms`);
          observer.observe(element);
        });
      }
      const command = document.querySelector<HTMLDialogElement>('.command-dialog');
      const commandInput = command?.querySelector<HTMLInputElement>('input');
      const commandLinks = [...(command?.querySelectorAll<HTMLAnchorElement>('[data-command-label]') ?? [])];
      function openCommand() {
        if (!command || !commandInput) return;
        closeMenu();
        commandInput.value = '';
        commandLinks.forEach(link => { link.hidden = false; });
        command.querySelectorAll<HTMLElement>('.command-group').forEach(group => { group.hidden = false; });
        const empty = command.querySelector<HTMLElement>('.command-empty');
        if (empty) empty.hidden = true;
        if (!command.open) command.showModal();
        commandInput.focus();
      }
      document.querySelector('.command-trigger')?.addEventListener('click', openCommand);
      command?.querySelector('.command-close')?.addEventListener('click', () => command.close());
      command?.addEventListener('click', event => { if (event.target === command) command.close(); });
      commandLinks.forEach(link => link.addEventListener('click', () => command?.close()));
      commandInput?.addEventListener('input', () => {
        const query = commandInput.value.trim().toLocaleLowerCase();
        let count = 0;
        commandLinks.forEach(link => {
          link.hidden = !link.dataset.commandLabel?.toLocaleLowerCase().includes(query);
          if (!link.hidden) count++;
        });
        command?.querySelectorAll<HTMLElement>('.command-group').forEach(group => { group.hidden = !group.querySelector('a:not([hidden])'); });
        const empty = command?.querySelector<HTMLElement>('.command-empty');
        if (empty) empty.hidden = count !== 0;
      });
      commandInput?.addEventListener('keydown', event => {
        if (event.key === 'Enter') commandLinks.find(link => !link.hidden)?.click();
        if (event.key === 'ArrowDown') { event.preventDefault(); commandLinks.find(link => !link.hidden)?.focus(); }
      });
      command?.addEventListener('keydown', event => {
        if (!(event.target instanceof HTMLAnchorElement) || !['ArrowDown', 'ArrowUp'].includes(event.key)) return;
        event.preventDefault();
        const visible = commandLinks.filter(link => !link.hidden);
        const current = visible.indexOf(event.target);
        visible[(current + (event.key === 'ArrowDown' ? 1 : -1) + visible.length) % visible.length]?.focus();
      });
      document.addEventListener('keydown', event => {
        const target = event.target as HTMLElement;
        const typing = target.matches('input, textarea, select') || target.isContentEditable;
        if (((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') || (event.key === '/' && !typing)) {
          event.preventDefault();
          if (command?.open) command.close(); else openCommand();
        }
      });
    </script>
  </body>
</html>
